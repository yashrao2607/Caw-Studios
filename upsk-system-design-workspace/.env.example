# .env.example -- Reference Environment Configuration
# This file documents every environment variable the service needs.
# Variables marked REQUIRED have no default and must be set.
# Variables marked OPTIONAL have a default noted in the comment.

# --- Application ---
APP_ENV=               # REQUIRED. One of: development, staging, production
PORT=                  # REQUIRED. Integer (e.g., 3000)

# --- Database ---
DATABASE_URL=          # REQUIRED. Full connection string: postgresql://user:pass@host:5432/db

# --- Authentication ---
JWT_SECRET=            # REQUIRED. Min 32 characters. Used to sign JWT tokens.

# --- CORS ---
CORS_ORIGIN=           # REQUIRED. Allowed origin URL (e.g., https://app.example.com)

# --- Logging ---
LOG_LEVEL=             # OPTIONAL. Default: info. One of: debug, info, warn, error
